<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the hardened runtime (ANG-57). The app is not sandboxed, so almost nothing
     has to be asked for: the web view runs in Apple's own helper processes, and the Keychain and
     Touch ID need no entitlement outside the sandbox. -->
<plist version="1.0">
<dict>
  <!-- Connections to PostgreSQL servers and SSH hosts. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
